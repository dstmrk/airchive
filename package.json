{
	"name": "airchive",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b",
		"check": "biome check .",
		"fix": "biome check --write .",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"cf-typegen:check": "wrangler types --env-file .dev.vars.example --check",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"better-auth": "^1.7.14",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.14",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@cloudflare/vite-plugin": "^1.66.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	}
}
